# WEB-002 environment example.
# Copy to .env.local for local development. Do not commit real .env files.

# Public browser-visible values must use NEXT_PUBLIC_*.
NEXT_PUBLIC_APP_ENV=local

# Optional for WEB-002. Future API work may decide whether browser code calls the
# backend directly or goes through Next.js server/proxy routes.
NEXT_PUBLIC_BACKEND_API_BASE_URL=

# Server-only values must not use NEXT_PUBLIC_*.
APP_ENV=local
